    "hospitalized": false,
    "quote": ""
  },
  {
    "id": "LTR-1862-09-27-001",
    "hospitalized": true,
    "quote": "I suppose you will be both surprised and grieved to hear that I am in a hospital."
  },
  {
    "id": "LTR-1862-09-28-001",
    "hospitalized": false,
    "quote": ""
  },
  {
    "id": "LTR-1862-10-01-001",
    "hospitalized": false,
    "quote": ""
  },
  {
    "id": "LTR-1862-10-12-001",
    "hospitalized": true,
    "quote": "I have had a pretty long pull off sickness but am getting well now fast. I expect to be able to return to the company before long."
  },
  {
    "id": "LTR-1862-10-29-001",
    "hospitalized": false,
    "quote": ""
  },
  {
    "id": "LTR-1862-11-12-001",
    "hospitalized": false,
    "quote": ""
  },
